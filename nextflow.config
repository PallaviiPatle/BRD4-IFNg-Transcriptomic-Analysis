nextflow.enable.dsl=2

params {
    input_file = "${projectDir}/01_GEO_Data/Raw/GSE248821_gene_RSEM_CPM_Brd4KO.xlsx"
    output_dir = "${projectDir}/results"
}

process {
    executor = 'local'

    cpus = 4
    memory = '8 GB'

    errorStrategy = 'terminate'
}

workDir = "${projectDir}/work"